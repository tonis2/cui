    "layout": {
      "type": "executable",
      "sources": [ "src/**", "test/layout.c3" ]
    },
    "composite": {
      "type": "executable",
      "sources": [ "src/**", "test/composite.c3" ]
    },
    "scroll": {
      "type": "executable",
      "sources": [ "src/**", "test/scroll.c3" ]
    },
    "text": {
      "type": "executable",
      "sources": [ "src/**", "test/text.c3" ]
    },
    "nodes": {
      "type": "executable",
      "sources": [ "src/**", "test/node_graph.c3" ]
    },
    "unittest": {
      "type": "executable",
      "sources": [ "src/**" ]
    }
  },
  "cpu": "generic",
  "opt": "O0"
}
