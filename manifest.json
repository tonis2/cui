{

  "provides" : "cui",
  "sources" : [
    "src/**",
    "lib/image.c3l/src/**",
    "lib/font.c3l/src/**",
    "lib/window.c3l/main.c3"
  ],
  "targets" : {
    "macos-x64" : {
      "sources" : ["lib/window.c3l/darwin/**"],
      "linked-libraries" : [
        "CoreFoundation.framework",
        "Cocoa.framework",
        "Metal.framework",
        "Foundation.framework",
        "AppKit.framework",
        "CoreGraphics.framework"
      ]
    },
    "macos-aarch64" : {
      "sources" : ["lib/window.c3l/darwin/**"],
      "linked-libraries" : [
        "CoreFoundation.framework",
        "Cocoa.framework",
        "Metal.framework",
        "Foundation.framework",
        "AppKit.framework",
        "CoreGraphics.framework"
      ]
    },
    "linux-x64" : {
      "sources" : ["lib/window.c3l/linux/**"],
      "linked-libraries" : []
    },
    "linux-aarch64" : {
      "sources" : ["lib/window.c3l/linux/**"],
      "linked-libraries" : []
    },
    "windows-x64" : {
      "sources" : ["lib/window.c3l/win32/**"],
      "linked-libraries" : ["user32.lib", "gdi32.lib", "kernel32.lib"]
    }
  }
}
